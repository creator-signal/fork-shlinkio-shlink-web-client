{
  "name": "shlink-web-client",
  "description": "Creator Signal's OIDC-protected operator client for Shlink",
  "private": false,
  "homepage": "",
  "repository": "https://github.com/shlinkio/shlink-web-client",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cs": "node --run lint && node --run format:check && node --run verify:release-workflow",
    "cs:fix": "node --run lint:fix && node --run format",
    "lint": "oxlint src server test config/test ./*.config.ts",
    "lint:fix": "node --run lint -- --fix",
    "format": "oxfmt src server test config/test ./*.ts",
    "format:check": "node --run format -- --check",
    "types": "tsc && tsc -p tsconfig.server.json",
    "start": "node server-dist/index.js",
    "start:client": "vite serve --host=0.0.0.0",
    "preview": "vite preview --host=0.0.0.0",
    "build": "node --run types && vite build && node scripts/replace-version.mjs && tsc -p tsconfig.server.json && node scripts/verify-browser-boundary.mjs",
    "build:dist": "node --run build && node scripts/create-dist-file.mjs",
    "test": "node --run test:browser && node --run test:server",
    "test:browser": "vitest run --run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:watch": "vitest --watch",
    "test:ci": "node --run test:browser -- --coverage && node --run test:server",
    "verify:browser-boundary": "node scripts/verify-browser-boundary.mjs",
    "verify:release-workflow": "node scripts/verify-release-workflow.mjs",
    "test:verbose": "node --run test -- --verbose"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@shlinkio/shlink-frontend-kit": "^1.5.0",
    "@shlinkio/shlink-web-component": "^0.19.2",
    "@vitest/browser-playwright": "^4.1.10",
    "bottlejs": "^2.0.1",
    "clsx": "^2.1.1",
    "compare-versions": "^6.1.1",
    "date-fns": "^4.4.0",
    "fastify": "5.12.0",
    "openid-client": "6.8.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-external-link": "^2.7.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "redis": "6.2.1",
    "redux-localstorage-simple": "^2.5.1"
  },
  "devDependencies": {
    "@shlinkio/eslint-config-js-coding-standard": "~4.0.0",
    "@shlinkio/shlink-js-sdk": "3.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.2",
    "adm-zip": "^0.6.0",
    "axe-core": "^4.12.1",
    "chalk": "^6.0.0",
    "history": "^5.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.3"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
